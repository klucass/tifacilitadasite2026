---
import { Image } from "astro:assets";
import capa from "../assets/images/capa-ebook.png";
---

<section
  id="topo"
  style="background:radial-gradient(ellipse at 85% 10%,rgba(88,0,255,0.45) 0%,rgba(88,0,255,0) 55%),#0B0B12;color:#fff"
>
  <div
    style="max-width:1180px;margin:0 auto;padding:clamp(48px,8vw,88px) clamp(20px,5vw,28px) clamp(56px,9vw,96px)"
  >
    <div
      style="display:flex;flex-wrap:wrap;gap:clamp(36px,6vw,64px);align-items:center;justify-content:center"
    >
      <div style="flex:1 1 420px;max-width:600px">
        <span
          style="display:inline-flex;align-items:center;gap:8px;background:#72FFFF;color:#0B0B12;padding:7px 14px;border-radius:999px;font-size:13px;font-weight:800;letter-spacing:0.04em;text-transform:uppercase;margin-bottom:22px"
          >Black Friday · de R$97 por R$67,90</span
        >
        <h1
          style="font-size:clamp(34px,6.4vw,48px);line-height:1.03;letter-spacing:-0.03em;font-weight:800;margin:0 0 22px;color:#fff"
        >
          Domine <span
            style="background:#72FFFF;color:#0B0B12;padding:0 8px;border-radius:4px"
          >
            Fluência em Dados
          </span> sem se perder em material extenso e confuso
        </h1>
        <p
          style="font-size:clamp(17px,2.4vw,19px);line-height:1.6;color:#C9C6D6;margin:0 0 34px;max-width:520px"
        >
          Resumos objetivos e esquematizados do que realmente cai em provas das
          áreas Fiscal e Controle com cadernos de questões do TEC Concursos.
        </p>
        <div
          style="display:flex;flex-wrap:wrap;align-items:center;gap:18px;margin-bottom:28px"
        >
          <a
            class="cta cta-primary"
            href="https://tifacilitada.miblify.com/fluencia-em-dados?coupon=BLACKFRIDAY30"
            style="text-decoration:none;background:#5800FF;color:#fff;padding:17px 28px;border-radius:11px;font-size:17px;font-weight:700;display:inline-flex;align-items:center;gap:10px"
            >Garantir meu acesso por R$67,90 <span style="font-size:18px">→</span
            ></a
          >
          <div style="font-size:14px;color:#A9A6B8;line-height:1.4">
            <span style="text-decoration:line-through">R$97</span>
            <strong style="color:#72FFFF">· 30% off com cupom BLACKFRIDAY30</strong><br />Acesso
            imediato · Garantia de 7 dias
          </div>
        </div>
        <div
          style="display:flex;flex-wrap:wrap;gap:clamp(18px,4vw,28px);align-items:center;padding-top:28px;border-top:1px solid #2A2A36"
        >
          <div>
            <div style="font-size:24px;font-weight:800;letter-spacing:-0.02em">
              +500
            </div>
            <div style="font-size:13px;color:#A9A6B8">
              concurseiros estudando
            </div>
          </div>

          <div style="width:1px;height:36px;background:#2A2A36"></div>
          <div>
            <div style="font-size:24px;font-weight:800;letter-spacing:-0.02em">
              100%
            </div>
            <div style="font-size:13px;color:#A9A6B8">digital · PDF</div>
          </div>
        </div>
      </div>
      <div
        style="flex:0 1 360px;display:flex;justify-content:center;max-width:100%"
      >
        <div
          style="position:relative;padding:16px;background:#16161F;border:1px solid #2A2A36;border-radius:20px;max-width:100%"
        >
          <Image
            src={capa}
            alt="Capa do e-book — Resumo Facilitado de Fluência em Dados"
            loading="eager"
            widths={[320, 480, 640]}
            sizes="(max-width: 444px) 72vw, 320px"
            style="width:min(320px,72vw);height:auto;border-radius:12px;display:block"
          />
          <div
            style="position:absolute;bottom:-14px;left:50%;transform:translateX(-50%);background:#72FFFF;color:#0B0B12;padding:8px 16px;border-radius:999px;font-size:12px;font-weight:800;white-space:nowrap"
          >
            Black Friday · -30%
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
