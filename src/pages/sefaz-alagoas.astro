---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { Image } from "astro:assets";
import logo from "../assets/images/logo.png";
import capa from "../assets/images/capa_alagoas.png";

const CHECKOUT = "https://tifacilitada.miblify.com/sefaz-alagoas";
const DEMO = "https://tifacilitada.miblify.com/demo-alagoas";

const aulaImports = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/aulas/*.png",
  { eager: true },
);

const totalAulas = Object.keys(aulaImports).length;

const gallery = Array.from({ length: totalAulas }, (_, i) => {
  const n = i + 1;
  return {
    id: `sefaz-mat-${String(n).padStart(2, "0")}`,
    src: aulaImports[`../assets/images/aulas/${n}.png`].default,
    alt: `Página ${n} do material de TI para a SEFAZ-AL`,
  };
});

// Distribuição de pontos de TI na prova da SEFAZ Alagoas.
const blocos = [
  {
    nome: "Ciência de Dados",
    pontos: 20,
    detalhe:
      "O bloco mais pesado da prova. Sozinho vale o dobro dos outros — e ainda volta na discursiva.",
  },
  {
    nome: "Inteligência Artificial",
    pontos: 10,
    detalhe:
      "Tema novo e em alta. Bem resumido, vira ponto garantido no seu placar.",
  },
  {
    nome: "Desenvolvimento",
    pontos: 10,
    detalhe:
      "O que a banca realmente cobra de desenvolvimento — sem virar curso de programação.",
  },
  {
    nome: "Infraestrutura de TIC e Segurança",
    pontos: 10,
    detalhe:
      "Conceitos que se repetem prova após prova, organizados em esquemas e tabelas.",
  },
];

const pontosObjetiva = blocos.reduce((soma, b) => soma + b.pontos, 0);
const pontosDiscursiva = 10;
const pontosTotais = pontosObjetiva + pontosDiscursiva;

const modulos = [
  {
    bloco: "Ciência de Dados",
    peso: "20 pontos na objetiva + 10 na discursiva",
    itens: [
      "Dado, informação, conhecimento e inteligência",
      "Dados estruturados, não estruturados e dados abertos",
      "Coleta, tratamento, armazenamento, integração e recuperação de dados",
      "Bancos de dados relacionais: conceitos e características",
      "Metadados, tabelas, visões, índices, chaves e relacionamentos",
      "Modelagem relacional, dimensional e multidimensional",
      "Planilhas e SQL",
      "Processo de ciência de dados e modelo de referência CRISP-DM",
      "Técnicas de pré-processamento de dados",
      "Visualização e análise exploratória de dados",
      "Mineração de dados: regras de associação, regressão e clusterização",
      "Detecção de anomalias e modelagem preditiva",
      "Aprendizado de máquina: fundamentos, algoritmos e métricas de desempenho",
      "Big Data: conceitos, premissas e aplicações",
      "Business Intelligence",
    ],
  },
  {
    bloco: "Inteligência Artificial",
    peso: "10 pontos na objetiva",
    itens: [
      "Fundamentos de inteligência artificial",
      "Redes neurais artificiais",
      "Deep learning",
      "Processamento de linguagem natural e mineração de texto",
      "Visão computacional",
      "IA generativa, modelos de linguagem de grande escala (LLM) e geração aumentada por recuperação (RAG)",
    ],
  },
  {
    bloco: "Desenvolvimento",
    peso: "10 pontos na objetiva",
    itens: [
      "Modelagem de processos de negócio",
      "Metodologias ágeis de desenvolvimento de software: XP, Scrum e Kanban",
      "Integração contínua e entrega contínua",
      "Arquitetura de software e arquitetura de microsserviços",
      "Arquitetura orientada a eventos",
      "Soluções de integração entre sistemas e API REST",
      "Testes de software: unitários, de integração e TDD",
      "Linguagem Java",
      "Linguagem JavaScript",
      "Ferramentas de versionamento Git",
      "Segurança no desenvolvimento",
      "Conceitos avançados em engenharia e arquitetura de software",
    ],
  },
  {
    bloco: "Infraestrutura de TIC e Segurança",
    peso: "10 pontos na objetiva",
    itens: [
      "Infraestrutura em nuvem",
      "Contêineres e orquestração: Docker, Podman e Kubernetes",
      "DevOps e DevSecOps: conceitos, práticas e ferramentas",
      "Gestão de serviços e ITIL v4: mudanças, liberação, incidentes, problemas e service desk",
      "Forense computacional: preservação de evidências, hash de arquivos e cadeia de custódia",
      "Coleta, espelhamento e imagem de discos",
      "Técnicas antiforense: criptografia e esteganografia",
      "Redes de computadores, firewall, WAF, proxy e proxy reverso",
      "Redes MPLS e SD-WAN, segmentação e microssegmentação de redes",
      "Segurança da informação: gestão, continuidade do negócio e gestão de riscos",
      "Gestão de identidade e acesso",
      "Arquitetura zero trust",
      "Identificação, análise e correção de vulnerabilidades",
      "Ataques em redes e aplicações corporativas e medidas de proteção",
      "Infraestrutura de chaves públicas e certificação digital",
      "Prevenção e tratamento de incidentes de segurança da informação",
    ],
  },
];

const totalTemasDiscursiva = 10;

const aulas = [
  {
    nome: "Gestão da Informação",
    bloco: "Ciência de Dados",
    disponivel: true,
    demo: true,
    assuntos: [
      "Dado, informação, conhecimento e inteligência",
      "Dados estruturados, não estruturados e dados abertos",
      "Coleta, tratamento, armazenamento, integração e recuperação de dados",
    ],
  },
  {
    nome: "Banco de Dados",
    bloco: "Ciência de Dados",
    disponivel: true,
    assuntos: [
      "Bancos de dados relacionais: conceitos e características",
      "Metadados, tabelas, visões, índices, chaves e relacionamentos",
    ],
  },
  {
    nome: "Modelagem Relacional",
    bloco: "Ciência de Dados",
    disponivel: true,
    assuntos: ["Modelagem relacional", "Álgebra relacional", "Normalização"],
  },
  {
    nome: "Machine Learning",
    bloco: "Ciência de Dados e IA",
    disponivel: true,
    assuntos: [
      "Aprendizado de máquina: fundamentos, principais algoritmos e métricas de desempenho",
      "Fundamentos de inteligência artificial",
      "Redes neurais artificiais e deep learning",
    ],
  },
  {
    nome: "Data Mining",
    bloco: "Ciência de Dados",
    disponivel: true,
    assuntos: [
      "Processo de ciência de dados e modelo de referência CRISP-DM",
      "Técnicas de pré-processamento de dados",
      "Mineração de dados: regras de associação, regressão e clusterização",
      "Detecção de anomalias e modelagem preditiva",
      "Visualização e análise exploratória de dados",
    ],
  },
  {
    nome: "SQL",
    bloco: "Ciência de Dados",
    disponivel: true,
    assuntos: [
      "SQL",
      "DDL, DML, DCL, DQL",
      "Agregações",
      "Junções",
      "Subconsultas",
      "Views",
      "Funções e procedimentos armazenados",
    ],
  },
  {
    nome: "Big Data",
    bloco: "Ciência de Dados",
    disponivel: true,
    assuntos: ["Big Data: conceitos, premissas e aplicações"],
  },
  {
    nome: "Business Intelligence e Modelagem Multidimensional",
    bloco: "Ciência de Dados",
    disponivel: true,
    assuntos: ["Business Intelligence", "Ferramentas de BI"],
  },
  {
    nome: "Inteligência Artificial Generativa",
    bloco: "Inteligência Artificial",
    disponivel: true,
    assuntos: [
      "Deep Learning",
      "IA generativa, modelos de linguagem de grande escala (LLM) e geração aumentada por recuperação (RAG)",
      "Processamento de linguagem natural e mineração de texto",
    ],
  },
  {
    nome: "Modelagem de Processos",
    bloco: "Desenvolvimento",
    previsao: "29/09",
    assuntos: [
      "Modelagem de processos de negócio",
      "Metodologias ágeis de desenvolvimento de software: XP, Scrum e Kanban",
    ],
  },
  {
    nome: "DevOps",
    bloco: "Desenvolvimento",
    previsao: "02/10",
    assuntos: [
      "DevOps e DevSecOps: conceitos, práticas e ferramentas",
      "Integração contínua e entrega contínua",
      "Segurança no desenvolvimento",
    ],
  },
  {
    nome: "Java",
    bloco: "Desenvolvimento",
    previsao: "06/10",
    assuntos: ["Linguagem Java"],
  },
  {
    nome: "JavaScript",
    bloco: "Desenvolvimento",
    previsao: "09/10",
    assuntos: ["Linguagem JavaScript"],
  },
  {
    nome: "Engenharia de Software",
    bloco: "Desenvolvimento",
    previsao: "13/10",
    assuntos: [
      "Arquitetura de software e arquitetura de microsserviços",
      "Arquitetura orientada a eventos",
      "Soluções de integração entre sistemas e API REST",
      "Testes de software: unitários, de integração e TDD",
      "Ferramentas de versionamento Git",
      "Conceitos avançados em engenharia e arquitetura de software",
    ],
  },
  {
    nome: "Infraestrutura e Cloud",
    bloco: "Infraestrutura de TIC e Segurança",
    previsao: "16/10",
    assuntos: [
      "Infraestrutura em nuvem",
      "Contêineres e orquestração: Docker, Podman e Kubernetes",
      "Redes de computadores, firewall, WAF, proxy e proxy reverso",
      "Redes MPLS e SD-WAN, segmentação e microssegmentação de redes",
    ],
  },
  {
    nome: "ITIL",
    bloco: "Infraestrutura de TIC e Segurança",
    previsao: "20/10",
    assuntos: [
      "Gestão de serviços de TI",
      "ITIL v4: controle de mudanças e gerenciamento de liberação",
      "Gerenciamento de incidentes e problemas, e service desk",
    ],
  },
  {
    nome: "Segurança da Informação",
    bloco: "Infraestrutura de TIC e Segurança",
    previsao: "23/10",
    assuntos: [
      "Segurança da informação: gestão, continuidade do negócio e gestão de riscos",
      "Gestão de identidade e acesso",
      "Arquitetura zero trust",
      "Identificação, análise e correção de vulnerabilidades",
      "Ataques em redes e aplicações corporativas e medidas de proteção",
      "Infraestrutura de chaves públicas e certificação digital",
      "Forense computacional: evidências, hash de arquivos e cadeia de custódia",
      "Coleta, espelhamento e imagem de discos, e técnicas antiforense",
      "Prevenção e tratamento de incidentes de segurança da informação",
    ],
  },
];

const aulasDisponiveis = aulas.filter((a) => a.disponivel).length;
const aulasPrevistas = aulas.length - aulasDisponiveis;

const faqs = [
  {
    q: "O material é específico para a SEFAZ Alagoas?",
    a: "Sim. O conteúdo é organizado bloco a bloco seguindo a divisão de pontos da prova de TI da SEFAZ-AL: Ciência de Dados, Inteligência Artificial, Desenvolvimento e Infraestrutura de TIC e Segurança — com peso maior justamente onde a prova concentra mais pontos.",
  },
  {
    q: "E as aulas que ainda não foram liberadas?",
    a: "Comprando agora, você recebe todas as aulas do material, sem pagar nada a mais. As já liberadas ficam disponíveis na hora e as demais entram na Área do Aluno conforme o cronograma previsto.",
  },
  {
    q: "Preciso saber de TI para começar?",
    a: "Não. O material é feito para quem não é da área. A linguagem é simples e cada tema começa do zero, com esquemas e mapas mentais no lugar de textos longos.",
  },
  {
    q: "Como eu recebo o material?",
    a: "Assim que a compra é confirmada, você recebe o acesso imediato ao material em PDF para baixar e usar onde e como quiser.",
  },
  {
    q: "É material impresso ou digital?",
    a: "É 100% digital, em PDF. Você lê no celular, tablet ou computador — e, se preferir estudar no papel, pode imprimir à vontade.",
  },
  {
    q: "Os cadernos de questões estão inclusos?",
    a: "Sim. Cada módulo inclui cadernos de questões do TEC Concursos para você treinar e fixar o conteúdo.",
  },
  {
    q: "O material ajuda na prova discursiva?",
    a: "Sim. Uma das 4 questões discursivas é de Ciência de Dados e vale 10 pontos. Além do módulo aprofundado, você recebe de bônus 10 temas de discursiva e o padrão de resposta, para chegar na prova sabendo o que escrever e como organizar o texto.",
  },
  {
    q: "O que vem no bônus de discursivas?",
    a: "São 10 temas de Ciência de Dados selecionados pela chance de cair na discursiva, acompanhados do padrão de resposta para você treinar a escrita antes da prova. O conteúdo é liberado junto com o material, na Área do Aluno.",
  },
  {
    q: "E se eu não gostar?",
    a: "Você tem 7 dias de garantia. Se o material não for o que esperava, basta pedir o reembolso e devolvemos 100% do valor, sem burocracia.",
  },
  {
    q: "Já sou aluno. Onde acesso o material?",
    a: "É só entrar na Área do Aluno com seu login e senha para acessar todo o conteúdo, quando e onde quiser.",
    link: {
      href: "https://app.miblify.com/login/my_library",
      label: "Acessar a Área do Aluno →",
    },
  },
];
---

<Layout
  title="TI Facilitada - SEFAZ Alagoas"
  description="Material de TI para a SEFAZ Alagoas: 60 pontos em jogo (50 na objetiva + 10 na discursiva de Ciência de Dados). Resumos esquematizados em PDF, cadernos de questões do TEC Concursos e bônus com 10 temas de discursiva e padrão de resposta. Acesso imediato e garantia de 7 dias."
>
  <Header />

  <!-- ===== HERO ===== -->
  <section
    id="topo"
    style="background:linear-gradient(180deg,#F0EDFA 0%,#FFFFFF 100%)"
  >
    <div
      style="max-width:1180px;margin:0 auto;padding:clamp(48px,8vw,88px) clamp(20px,5vw,28px) clamp(56px,9vw,96px)"
    >
      <div
        style="display:flex;flex-wrap:wrap;gap:clamp(36px,6vw,64px);align-items:center;justify-content:center"
      >
        <div style="flex:1 1 420px;max-width:600px">
          <span
            style="display:inline-flex;align-items:center;background:#5800FF;color:#F0EDFA;padding:7px 14px;border-radius:999px;font-size:13px;font-weight:600;margin-bottom:22px"
            >Resumo em PDF · Pós-edital · SEFAZ AL</span
          >
          <h1
            style="font-size:clamp(34px,6.4vw,48px);line-height:1.03;letter-spacing:-0.03em;font-weight:800;margin:0 0 22px"
          >
            Garanta os <span
              style="background:#72FFFF;padding:0 8px;border-radius:4px"
              >30% da prova</span
            > que estão em TI na SEFAZ Alagoas
          </h1>
          <p
            style="font-size:clamp(17px,2.4vw,19px);line-height:1.6;color:#4A4A55;margin:0 0 20px;max-width:540px"
          >
            São <strong style="color:#0B0B12">{pontosObjetiva} pontos</strong> na
            prova objetiva mais <strong style="color:#0B0B12"
              >{pontosDiscursiva} pontos</strong
            > na discursiva de Ciência de Dados. É a maior concentração de pontos
            do edital.
          </p>
          <p
            style="font-size:clamp(17px,2.4vw,19px);line-height:1.6;color:#4A4A55;margin:0 0 34px;max-width:540px"
          >
            Este material entrega esses {pontosTotais} pontos resumidos, esquematizados
            e com cadernos de questões, feito para quem não é da área. Inclui 10 temas
            de discursiva e o padrão de resposta da questão de Ciência de Dados.
          </p>
          <div
            style="display:flex;flex-wrap:wrap;align-items:center;gap:18px;margin-bottom:28px"
          >
            <a
              class="cta cta-primary"
              href={CHECKOUT}
              style="text-decoration:none;background:#5800FF;color:#fff;padding:17px 28px;border-radius:11px;font-size:17px;font-weight:700;display:inline-flex;align-items:center;gap:10px"
              >Garantir meu acesso por R$249 <span style="font-size:18px"
                >→</span
              ></a
            >
            <div style="font-size:14px;color:#6A6A75;line-height:1.4">
              Acesso imediato<br />Garantia de 7 dias
            </div>
          </div>
          <p style="font-size:15px;color:#5A5A66;margin:-8px 0 28px">
            Quer ver antes de comprar?{" "}
            <a
              href={DEMO}
              target="_blank"
              rel="noopener"
              style="color:#5800FF;font-weight:700;text-decoration:underline;text-underline-offset:3px"
              >Baixe a aula demonstrativa de Gestão da Informação</a
            >
          </p>
          <div
            style="display:flex;flex-wrap:wrap;gap:clamp(18px,4vw,28px);align-items:center;padding-top:28px;border-top:1px solid #ECEAF6"
          >
            <div>
              <div
                style="font-size:24px;font-weight:800;letter-spacing:-0.02em"
              >
                {pontosTotais}
              </div>
              <div style="font-size:13px;color:#6A6A75">
                pontos de TI em jogo
              </div>
            </div>
            <div style="width:1px;height:36px;background:#ECEAF6"></div>
            <div>
              <div
                style="font-size:24px;font-weight:800;letter-spacing:-0.02em"
              >
                30%
              </div>
              <div style="font-size:13px;color:#6A6A75">
                da pontuação da prova
              </div>
            </div>
            <div style="width:1px;height:36px;background:#ECEAF6"></div>
            <div>
              <div
                style="font-size:24px;font-weight:800;letter-spacing:-0.02em"
              >
                100%
              </div>
              <div style="font-size:13px;color:#6A6A75">digital · PDF</div>
            </div>
          </div>
        </div>
        <div
          style="flex:0 1 360px;display:flex;justify-content:center;max-width:100%"
        >
          <div
            style="position:relative;padding:16px;background:#F6F4FC;border:1px solid #ECEAF6;border-radius:20px;max-width:100%"
          >
            <Image
              src={capa}
              alt="Capa do Resumo Facilitado de Tecnologia da Informação — Pós Edital SEFAZ AL, Auditor Fiscal"
              loading="eager"
              widths={[320, 480, 640]}
              sizes="(max-width: 444px) 72vw, 320px"
              style="width:min(320px,72vw);height:auto;border-radius:12px;display:block"
            />
            <div
              style="position:absolute;bottom:-14px;left:50%;transform:translateX(-50%);background:#0B0B12;color:#fff;padding:8px 16px;border-radius:999px;font-size:12px;font-weight:600;white-space:nowrap"
            >
              SEFAZ AL · Auditor Fiscal
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PONTUAÇÃO ===== -->
  <section
    id="pontuacao"
    style="background:#F6F4FC;border-top:1px solid #ECEAF6;border-bottom:1px solid #ECEAF6"
  >
    <div
      style="max-width:1180px;margin:0 auto;padding:clamp(64px,9vw,104px) clamp(20px,5vw,28px)"
    >
      <div style="max-width:720px;margin-bottom:clamp(36px,5vw,48px)">
        <span
          style="display:inline-flex;align-items:center;background:#F0EDFA;color:#5800FF;padding:7px 14px;border-radius:999px;font-size:13px;font-weight:600;margin-bottom:18px"
          >Onde estão os pontos</span
        >
        <h2
          style="font-size:clamp(28px,4.6vw,44px);line-height:1.06;letter-spacing:-0.025em;font-weight:800;margin:0 0 16px"
        >
          Saiba exatamente onde estão os seus pontos.
        </h2>
        <p
          style="font-size:18px;line-height:1.6;color:#5A5A66;margin:0;max-width:620px"
        >
          São {pontosTotais} pontos ao alcance de quem estuda com direcionamento.
          Veja como eles se distribuem na prova da SEFAZ Alagoas e revise cada bloco
          no peso que ele merece.
        </p>
      </div>

      <div
        style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;margin-bottom:24px"
      >
        {
          blocos.map((b) => (
            <div style="background:#fff;border:1px solid #ECEAF6;border-radius:16px;padding:clamp(24px,4vw,30px)">
              <div style="display:flex;align-items:baseline;gap:8px;margin-bottom:14px">
                <span style="font-size:40px;font-weight:800;letter-spacing:-0.03em;line-height:1;color:#5800FF">
                  {b.pontos}
                </span>
                <span style="font-size:14px;font-weight:600;color:#8A8A95">
                  pontos
                </span>
              </div>
              <h3 style="font-size:18px;font-weight:700;letter-spacing:-0.01em;margin:0 0 10px">
                {b.nome}
              </h3>
              <div
                aria-hidden="true"
                style="height:6px;border-radius:999px;background:#ECEAF6;margin-bottom:14px;overflow:hidden"
              >
                <div
                  style={`height:100%;border-radius:999px;background:#5800FF;width:${(b.pontos / 20) * 100}%`}
                />
              </div>
              <p style="font-size:15px;line-height:1.6;color:#5A5A66;margin:0">
                {b.detalhe}
              </p>
            </div>
          ))
        }
      </div>

      <div
        style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px"
      >
        <div
          style="background:#fff;border:1px solid #C9B8F0;border-radius:16px;padding:clamp(24px,4vw,30px)"
        >
          <div
            style="display:flex;align-items:baseline;gap:8px;margin-bottom:14px"
          >
            <span
              style="font-size:40px;font-weight:800;letter-spacing:-0.03em;line-height:1;color:#5800FF"
              >{pontosDiscursiva}</span
            ><span style="font-size:14px;font-weight:600;color:#8A8A95"
              >pontos</span
            >
          </div>
          <h3
            style="font-size:18px;font-weight:700;letter-spacing:-0.01em;margin:0 0 10px"
          >
            Prova discursiva
          </h3>
          <p style="font-size:15px;line-height:1.6;color:#5A5A66;margin:0">
            Uma das 4 questões discursivas tem tema de <strong
              style="color:#3A3A44">Ciência de Dados</strong
            >. Com o bloco dominado e o padrão de resposta em mãos, você escreve
            com repertório e estrutura.
          </p>
        </div>
        <div
          style="background:#5800FF;color:#fff;border-radius:16px;padding:clamp(24px,4vw,30px);display:flex;flex-direction:column;justify-content:center"
