  <style>
    #galeria-track {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    #galeria-track::-webkit-scrollbar {
      display: none;
    }
    .faq summary::-webkit-details-marker,
    .aula summary::-webkit-details-marker {
      display: none;
    }
    .aula .aula-icon::before {
      content: "+";
